{
    "name": "calmfox/watch-sylius",
    "description": "Monitoring wnętrza sklepu Sylius dla Calmfox Watch: sekretny adres kontrolny ze stanem usług (baza, dysk, poczta, kolejki, pamięć podręczna, ścieżka zakupowa, zadania cykliczne), podstawowa higiena bezpieczeństwa i historia zmian wersji pakietów.",
    "type": "symfony-bundle",
    "keywords": ["sylius", "sylius-plugin", "monitoring", "health", "uptime", "security"],
    "license": "MIT",
    "homepage": "https://watch.calmfox.net",
    "authors": [
        {
            "name": "Calmfox",
            "email": "kontakt@calmfox.pl",
            "homepage": "https://calmfox.pl"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "doctrine/dbal": "^3.6 || ^4.0",
        "doctrine/persistence": "^2.5 || ^3.0 || ^4.0",
        "psr/cache": "^2.0 || ^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "sylius/sylius": "^1.12 || ^2.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0",
        "symfony/security-core": "^6.4 || ^7.0",
        "symfony/security-csrf": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "symfony/messenger": "Sprawdzenie zaległości w kolejkach (transport doctrine).",
        "symfony/process": "Wymagane przez polecenie calmfox:watch:updates (liczenie zaległych aktualizacji Composera)."
    },
    "autoload": {
        "psr-4": {
            "Calmfox\\WatchBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calmfox\\WatchBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
